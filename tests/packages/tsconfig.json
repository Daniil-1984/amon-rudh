{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "tests",
    "mobile_tests",
    "tests/pages",
    "first.load.test.js",
    "LOAD_TESTS/test.js",
    "playwright.config.ts"
  ]
}
